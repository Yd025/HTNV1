# Offline team development; no sponsor credentials required.
ADAPTER=local
FORCE_KINEMATIC=1
BRAIN_HZ=10
# Optional bounded evidence recording (relative to backend/ when running Python).
RUN_LOG_DIR=
RUN_SCENARIO=local-weave
# Use ADAPTER=replay with a complete recorded run directory.
REPLAY_PATH=
# Database work retries independently; use 0 for native offline development.
DATABASE_ENABLED=1
DB_TIMEOUT_SEC=2
DB_RETRY_SEC=15
WS_SEND_TIMEOUT_SEC=2
ADVISOR_TIMEOUT_SEC=12
STATE_STALE_SEC=3
SHUTDOWN_TIMEOUT_SEC=5
BACKEND_PORT=8000
POSTGRES_PORT=5432
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_API_URL=http://localhost:8000

# Person 4 configures this only when deliberately testing the ArcticSim adapter.
ARCTIC_HOST=host.docker.internal

# Optional server-side integrations. Never commit a filled-in .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon
SENTRY_RELEASE=
# Use 1.0 for a short evidence/demo run, 0.1 for normal operation.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser ingestion DSN is public; auth tokens must never use NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=hackathon
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
WHITEOUT_TOKEN=
