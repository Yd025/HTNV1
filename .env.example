# Offline team development; no sponsor credentials required.
ADAPTER=local
FORCE_KINEMATIC=1
# Optional trained local placement, relative to backend/. Leave empty for normal behavior.
# Synthetic policy files are rejected by live, replay and hybrid adapters.
SEARCH_POLICY_FILE=
BRAIN_HZ=10
# Optional bounded evidence recording (relative to backend/ when running Python).
RUN_LOG_DIR=
RUN_SCENARIO=local-weave
# Use ADAPTER=replay with a complete recorded run directory.
REPLAY_PATH=
# Database work retries independently; use 0 for native offline development.
DATABASE_ENABLED=1
DB_TIMEOUT_SEC=2
DB_RETRY_SEC=15
WS_SEND_TIMEOUT_SEC=2
ADVISOR_TIMEOUT_SEC=12
STATE_STALE_SEC=3
SHUTDOWN_TIMEOUT_SEC=5
BACKEND_PORT=8000
POSTGRES_PORT=5432
# Browser addresses: use published host ports; replace localhost for remote access.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SIM_VIEWER_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SIM_CONTROL_URL=http://127.0.0.1:8090
NEXT_PUBLIC_GAME_URL=http://localhost:3100
# Compose routes server-side backend requests to http://backend:8000 automatically.
# Its simulator defaults use host.docker.internal to reach the separate ArcticSim stack.
# Optional Docker overrides (server-only; these must not be browser URLs):
# SIM_VIEWER_INTERNAL_URL=http://host.docker.internal:8080
# SIM_CONTROL_URL=http://host.docker.internal:8090
# GAME_SERVICE_URL=http://host.docker.internal:3100
# Native Next.js: set these in frontend/.env.local or the launch shell if needed.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# SIM_VIEWER_INTERNAL_URL=http://127.0.0.1:8080
# SIM_CONTROL_URL=http://127.0.0.1:8090
# GAME_SERVICE_URL=http://127.0.0.1:3100
# Native frontend experiment worker: Python with requirements-training.txt installed.
# Set in frontend/.env.local or the shell that launches Next.js.
GRAPH_PYTHON=
# Optional browser-visible CARTO basemap key. Empty uses OpenStreetMap tiles.
# Native frontend: put this in frontend/.env.local; Compose: put it in root .env.
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=

# Deliberate local ArcticSim integration: ADAPTER=whiteout; keep local mode as default.
# Docker uses host.docker.internal; native Python uses ARCTIC_HOST=127.0.0.1.
ARCTIC_HOST=host.docker.internal
# Fleet identity checks reject crossed telemetry even on a shared UDP stream.
# Default ArcticSim roster; change only to match a deliberately reconfigured simulator.
# ARCTIC_QUAD_SYSID=1
# ARCTIC_PLANE_SYSID=2
# ARCTIC_TOWER1_SYSID=4
# ARCTIC_TOWER2_SYSID=5

# Camera perception runs outside the control loop. Blob is only a simulator baseline.
# Install backend/requirements-vision.txt in your Python environment for yolo.
VESSEL_DETECTOR=blob
# Explicit trusted local .pt or .onnx object-detection model, with vessel classes.
VESSEL_MODEL_PATH=
VESSEL_CLASSES=boat,ship,vessel
VESSEL_CONFIDENCE=0.4
VESSEL_IMAGE_SIZE=960
VESSEL_DEVICE=cpu

# Optional server-side integrations. Never commit a filled-in .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon
SENTRY_RELEASE=
# Use 1.0 for a short evidence/demo run, 0.1 for normal operation.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser ingestion DSN is public; auth tokens must never use NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=hackathon
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
WHITEOUT_TOKEN=

SENTRY_ORG=

SENTRY_PROJECT=

NEXT_PUBLIC_SENTRY_ORG=

NEXT_PUBLIC_SENTRY_PROJECT=
