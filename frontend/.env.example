# Native Next.js: copy to .env.local and use your project's public DSN.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=hackathon
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Server defaults to the public DSN when omitted.
SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional build-time source-map upload token. Never expose it to the browser.
SENTRY_AUTH_TOKEN=
# Browser-reachable native simulator. Docker uses a separate internal fetch URL.
NEXT_PUBLIC_SIM_VIEWER_URL=http://127.0.0.1:8080
# SIM_VIEWER_INTERNAL_URL=http://host.docker.internal:8080
