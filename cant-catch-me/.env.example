# Sentry integration adapted from origin/sentra-change.
# Copy to .env.local; never commit API tokens or local settings.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon
NEXT_PUBLIC_SENTRY_ENVIRONMENT=hackathon
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional IDs or slugs; defaults are derived from the DSN.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_API_BASE=https://us.sentry.io
# A server-only token with project:read; required to retrieve attempt attachments.
SENTRY_API_TOKEN=
